# ==============================================================================
# LAB GUARD - FYP Environment Configuration Template (LabGuard-X)
# ==============================================================================

# Application Metadata
PROJECT_NAME="LabGuard-X"
VERSION="0.1.0"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"

# FastAPI Server Settings
HOST="127.0.0.1"
PORT=8000

# Database Configuration (PostgreSQL / Supabase or SQLite)
DATABASE_URL="postgresql://postgres:your-db-password@db.your-ref.supabase.co:5432/postgres"
# Or local SQLite:
# DATABASE_URL="sqlite:///./lab_guard.db"

# Supabase Credentials (from your dashboard)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Security & JWT Tokens
SECRET_KEY="your-super-secret-jwt-key-change-this-in-production"
JWT_SECRET_KEY="your-super-secret-jwt-key-change-this-in-production"
ALGORITHM="HS256"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# Initial Superuser Account
FIRST_SUPERUSER_EMAIL="admin@labguard.local"
FIRST_SUPERUSER_PASSWORD="Admin@123456"

# CORS Configuration
CORS_ORIGINS="*"

# IoT Gateway & Hardware Auth
IOT_DEFAULT_API_KEY="labguard-iot-secret-device-key-2026"
IOT_HEARTBEAT_TIMEOUT_SECONDS=120

# AI & Anomaly Detection Settings
AI_ANOMALY_THRESHOLD=0.85
AI_MODEL_DIRECTORY="./ml_models"

REFRESH_TOKEN_EXPIRE_DAYS=7

# Initial Superuser Account
FIRST_SUPERUSER_EMAIL="admin@labguard.local"
FIRST_SUPERUSER_PASSWORD="Admin@123456"

# CORS Configuration
CORS_ORIGINS="*"

# IoT Gateway & Hardware Auth
IOT_DEFAULT_API_KEY="labguard-iot-secret-device-key-2026"
